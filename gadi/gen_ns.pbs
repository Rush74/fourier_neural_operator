#!/bin/bash
# Generate Navier-Stokes training data: 8 seeded solver runs, one per GPU.
# Submit from the repository root: qsub gadi/gen_ns.pbs
#PBS -P dv70
#PBS -q dgxa100
#PBS -l ngpus=8
#PBS -l ncpus=128
#PBS -l mem=1000GB
#PBS -l walltime=24:00:00
#PBS -l storage=gdata/dv70+scratch/dv70+gdata/dk92
#PBS -l wd
#PBS -N ns_gen
#PBS -j oe

module use /g/data/dk92/apps/Modules/modulefiles
module load pet/2025.08
export OMP_NUM_THREADS=16

VISC=1e-3
T=50
GEN=/scratch/dv70/pag548/fno/gen/V${VISC}_T${T}
mkdir -p $GEN

for i in $(seq 0 7); do
  CUDA_VISIBLE_DEVICES=$i python data_generation/navier_stokes/ns_2d_gadi.py \
      --seed $i --n 640 --batch 64 --visc $VISC --T $T --out $GEN/ns_$i.mat > $GEN/gen_$i.log 2>&1 &
done
wait

# 8 x 640 = 5120 samples in one file that MatReader can read
python gadi/merge_shards.py --out /g/data/dv70/pag548/fno/data/PDE_datasets/NavierStokes_V${VISC}_N5120_T${T}.mat $GEN/ns_?.mat
